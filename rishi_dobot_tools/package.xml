<?xml version="1.0"?>
<package format="3">
  <name>rishi_dobot_tools</name>
  <version>0.1.0</version>
  <description>Additional Dobot Magician ROS 2 tools and experiments.</description>

  <maintainer email="rishi.g5714q@example.invalid">RISHI G</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

